# Copy to .env and fill in. Never commit .env.

# LLM (Groq free tier, OpenAI-compatible API)
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

# Speech-to-text: "local" (faster-whisper on this machine, default) or
# "hosted" (Whisper over an OpenAI-compatible API — used by the Render
# deploy). STT_API_KEY / STT_BASE_URL default to the LLM_* values above.
# STT_BACKEND=local
# STT_MODEL=whisper-large-v3

# Shared passcode for the public voice demo. Leave unset locally (no gate).
# DEMO_PASSCODE=

# Shopify dev store
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_ADMIN_TOKEN=
